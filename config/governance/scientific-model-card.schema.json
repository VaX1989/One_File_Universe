{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-file-universe.invalid/schema/scientific-model-card-1.json",
  "title": "OFU Scientific Model Card",
  "type": "object",
  "additionalProperties": true,
  "required": ["id","version","title","authority","fidelity","inputs","outputs","validDomain","limitations","forbiddenClaims","references","validation","determinism"],
  "properties": {
    "id": {"type":"string","minLength":1,"maxLength":160},
    "version": {"type":"string","minLength":1,"maxLength":80},
    "title": {"type":"string","minLength":1,"maxLength":240},
    "authority": {"enum":["RESEARCH_ONLY","CANONICAL_TRUTH","DERIVED_CANONICAL_STATE","MODEL_DERIVED_SIMULATION","EMPIRICAL_RELATION","PRESENTATION_ONLY","MEASURED_RUNTIME_EVIDENCE"]},
    "fidelity": {"enum":["FORMAL","EMPIRICALLY_CONSTRAINED","STYLIZED_CAUSAL","GENERATIVE_FICTIONAL"]},
    "inputs": {"type":"array","items":{"type":"object"}},
    "outputs": {"type":"array","items":{"type":"object"}},
    "validDomain": {"type":"string","minLength":1},
    "invariants": {"type":"array","items":{"type":"string"}},
    "uncertainty": {"type":["string","object"]},
    "limitations": {"type":"array","minItems":1,"items":{"type":"string"}},
    "forbiddenClaims": {"type":"array","minItems":1,"items":{"type":"string"}},
    "references": {"type":"array","items":{"type":"object","required":["citation"],"properties":{"citation":{"type":"string"},"doi":{"type":"string"},"url":{"type":"string"}}}},
    "datasets": {"type":"array","items":{"type":"object","required":["id","license","provenance"],"properties":{"id":{"type":"string"},"version":{"type":"string"},"license":{"type":"string"},"provenance":{"type":"string"},"checksum":{"type":"string"}}}},
    "validation": {"type":"object","required":["method"],"properties":{"method":{"type":"string"},"oracle":{"type":"string"},"tolerance":{"type":["string","number"]}}},
    "determinism": {"type":"object","required":["class"],"properties":{"class":{"enum":["D0","D1","D2","D3"]},"numericAssumptions":{"type":"string"}}}
  }
}
