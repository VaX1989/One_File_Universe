{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-file-universe.invalid/schemas/contribution-unit.schema.json",
  "title": "One File Universe Contribution Unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","id","version","area","authority","determinismClass","scientificFidelityClass","canonicalStateImpact","persistenceImpact","capabilities","dependencies","sourcePaths","testPaths","artifactReachability"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9.-]+$"},
    "version": {"type":"string","minLength":1},
    "area": {"type":"string","minLength":1},
    "description": {"type":"string"},
    "authority": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "determinismClass": {"type":"string","enum":["D0","D1","D2","D3","NOT_APPLICABLE"]},
    "scientificFidelityClass": {"type":"string","minLength":1},
    "canonicalStateImpact": {"type":"string","enum":["NONE","READ_ONLY","DERIVED","MUTATES_CANONICAL_STATE"]},
    "persistenceImpact": {"type":"string","enum":["NONE","READ_ONLY","FORMAT_COMPATIBLE","FORMAT_OR_SEMANTICS_CHANGE"]},
    "capabilities": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "dependencies": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "sourcePaths": {"type":"array","items":{"type":"string"},"minItems":1},
    "testPaths": {"type":"array","items":{"type":"string"}},
    "evidencePaths": {"type":"array","items":{"type":"string"}},
    "resourceBudget": {"type":"object","additionalProperties":true},
    "artifactReachability": {"type":"string","enum":["SHIPPING_REQUIRED","SHIPPING_OPTIONAL","NON_SHIPPING"]},
    "compatibilityVersion": {"type":"string"},
    "notes": {"type":"string"}
  }
}
