  "properties": {
    "contract": {"const": "ofu.r6.quality-observatory.observation.v1"},
    "witness": {"type": "object", "required": ["address", "seed", "modelVersion"], "properties": {"address": {"type": "string", "minLength": 1}, "seed": {"type": "string", "minLength": 1}, "modelVersion": {"type": "string", "minLength": 1}, "stage": {"type": "string"}, "sampleId": {"type": "string"}}, "additionalProperties": true},
    "descriptors": {"type": "object", "description": "Harness-normalized perceptual descriptor groups.", "properties": {"silhouetteTopography": {}, "horizonLandformProfile": {}, "spatialFrequencyRoughness": {}, "atmosphereSkyRegime": {}, "materialFamily": {}, "objectDensityClustering": {}, "scaleDistribution": {}, "palette": {}, "causalFingerprint": {}, "microstructureTopology": {}}, "additionalProperties": true},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "failures": {"type": "array"}, "representation": {"type": "object"}, "visual": {"type": "object"}, "human": {"type": "object"}, "transition": {"type": "object"}, "performance": {"type": "object"}, "resources": {"type": "object"}, "queue": {"type": "object"}, "runtime": {"type": "object"}, "provenance": {"type": "object"}, "accessibility": {"type": "object"},
    "imageEvidence": {"type": "object", "description": "Supporting visual similarity evidence only; not diversity-score authority."},
    "outputFingerprint": {"type": "string"}, "journeyKey": {"type": "string"}, "sequence": {"type": "number"}
  },
  "additionalProperties": true
}
